# Gateway service (Socket.IO) — lobby + realtime game state
VITE_GATEWAY_URL=http://localhost:4000

# Auth service (plain REST) — Google OAuth exchange + dev quick-login
VITE_AUTH_URL=http://localhost:4001

# Google Identity Services OAuth client id (leave blank to hide the Google button)
VITE_GOOGLE_CLIENT_ID=

# Show the "Dev quick login" form (display-name only, no OAuth) — always on in `vite dev`,
# set this explicitly to also enable it in a production-mode build (e.g. a staging deploy).
VITE_ALLOW_DEV_LOGIN=true
